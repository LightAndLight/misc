cabal-version:      3.0
name:               x20260124-image-kmeans
version:            0.1.0.0
license:            GPL-3.0-only
license-file:       LICENSE
author:             Isaac Elliott
maintainer:         isaace71295@gmail.com
category:           Graphics
build-type:         Simple

common warnings
    ghc-options: -Wall

executable x20260124-image-kmeans
    import:           warnings
    main-is:          Main.hs
    build-depends:
        JuicyPixels,
        async,
        base ^>=4.20.2.0,
        containers,
        random,
        stm,
        vector
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
